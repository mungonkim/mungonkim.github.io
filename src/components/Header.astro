---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<a class="brand" href="/">
			<span class="dot" aria-hidden="true"></span>
			{SITE_TITLE}
		</a>
		<div class="links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
			<a class="github" href="https://github.com/mungonkim" target="_blank" rel="noopener">
				<span class="sr-only">GitHub 프로필 보기</span>
				<svg viewBox="0 0 16 16" aria-hidden="true" width="22" height="22">
					<path
						fill="currentColor"
						d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
					></path>
				</svg>
			</a>
			<button id="theme-toggle" class="theme-toggle" type="button" aria-label="라이트/다크 모드 전환">
				<svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true" width="20" height="20">
					<path
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
						d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
				</svg>
				<svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true" width="20" height="20">
					<circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2"></circle>
					<path
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
					></path>
				</svg>
			</button>
		</div>
	</nav>
</header>

<script>
	// 현재 적용 중인 테마(직접 고른 값 또는 기기 설정)의 반대로 전환하고 선택을 저장한다
	const toggle = document.getElementById('theme-toggle');
	toggle?.addEventListener('click', () => {
		const root = document.documentElement;
		const current =
			root.getAttribute('data-theme') ??
			(window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
		const next = current === 'dark' ? 'light' : 'dark';
		root.setAttribute('data-theme', next);
		// 댓글창 등 다른 컴포넌트가 테마 변경을 알 수 있도록 이벤트를 보낸다
		window.dispatchEvent(new Event('themechange'));
		try {
			localStorage.setItem('theme', next);
		} catch (e) {
			// 저장에 실패해도 현재 페이지에서는 전환된다
		}
	});
</script>

<style>
	header {
		position: sticky;
		top: 0;
		z-index: 10;
		background: var(--header-bg);
		backdrop-filter: saturate(180%) blur(12px);
		-webkit-backdrop-filter: saturate(180%) blur(12px);
		border-bottom: 1px solid var(--border);
	}
	nav {
		width: 960px;
		max-width: 100%;
		margin: 0 auto;
		padding: 0.9rem 1.25rem;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
	}
	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		color: var(--text);
		font-weight: 800;
		font-size: 1.1rem;
		letter-spacing: -0.02em;
		text-decoration: none;
	}
	.brand:hover {
		color: var(--text);
	}
	.dot {
		width: 14px;
		height: 14px;
		border-radius: 50%;
		background: var(--gradient);
	}
	.links {
		display: flex;
		align-items: center;
		gap: 0.25rem;
	}
	.github {
		display: flex;
		align-items: center;
		padding: 0.4rem 0.5rem;
		color: var(--muted);
		border-radius: 999px;
	}
	.github:hover {
		color: var(--text);
	}
	.theme-toggle {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 36px;
		height: 36px;
		margin-left: 0.25rem;
		padding: 0;
		color: var(--muted);
		background: transparent;
		border: 1px solid var(--border);
		border-radius: 999px;
		cursor: pointer;
		transition:
			color 0.15s ease,
			background 0.15s ease,
			border-color 0.15s ease;
	}
	.theme-toggle:hover {
		color: var(--accent);
		background: var(--accent-soft);
		border-color: var(--accent);
	}
	/* 라이트일 때는 달(다크로 전환), 다크일 때는 해(라이트로 전환) 아이콘을 보여준다 */
	.icon-sun {
		display: none;
	}
	:global(:root[data-theme='dark']) .icon-moon {
		display: none;
	}
	:global(:root[data-theme='dark']) .icon-sun {
		display: block;
	}
	@media (prefers-color-scheme: dark) {
		:global(:root:not([data-theme='light'])) .icon-moon {
			display: none;
		}
		:global(:root:not([data-theme='light'])) .icon-sun {
			display: block;
		}
	}
	@media (max-width: 520px) {
		.brand {
			font-size: 1rem;
		}
		.github {
			display: none;
		}
	}
</style>
