---
// giscus 댓글창: GitHub Discussions를 댓글 저장소로 사용한다.
// 글 경로(pathname)마다 토론 스레드 하나가 대응된다.
---

<section class="comments" aria-label="댓글">
	<h2>댓글</h2>
	<p class="hint">GitHub 계정으로 댓글을 남길 수 있어요.</p>
	<div id="giscus-container"></div>
</section>

<style>
	.comments {
		margin-top: 4rem;
		padding-top: 2rem;
		border-top: 1px solid var(--border);
	}
	.comments h2 {
		margin-bottom: 0.3rem;
		font-size: 1.3rem;
	}
	.hint {
		margin-bottom: 1.5rem;
		color: var(--muted);
		font-size: 0.9rem;
	}
</style>

<script>
	const GISCUS_ORIGIN = 'https://giscus.app';

	// 현재 적용 중인 테마(직접 고른 값 또는 기기 설정)를 giscus 테마 이름으로 변환한다
	const getTheme = (): 'light' | 'dark' => {
		const saved = document.documentElement.getAttribute('data-theme');
		if (saved === 'light' || saved === 'dark') return saved;
		return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
	};

	const container = document.getElementById('giscus-container');
	if (container) {
		const script = document.createElement('script');
		script.src = `${GISCUS_ORIGIN}/client.js`;
		script.async = true;
		script.crossOrigin = 'anonymous';
		script.setAttribute('data-repo', 'mungonkim/mungonkim.github.io');
		script.setAttribute('data-repo-id', 'R_kgDOVAhpPQ');
		script.setAttribute('data-category', 'Announcements');
		script.setAttribute('data-category-id', 'DIC_kwDOVAhpPc4DHUNL');
		script.setAttribute('data-mapping', 'pathname');
		script.setAttribute('data-strict', '0');
		script.setAttribute('data-reactions-enabled', '1');
		script.setAttribute('data-emit-metadata', '0');
		script.setAttribute('data-input-position', 'top');
		script.setAttribute('data-theme', getTheme());
		script.setAttribute('data-lang', 'ko');
		script.setAttribute('data-loading', 'lazy');
		container.appendChild(script);
	}

	// 헤더의 토글로 테마가 바뀌면 이미 떠 있는 댓글창에도 반영한다
	window.addEventListener('themechange', () => {
		const iframe = document.querySelector<HTMLIFrameElement>('iframe.giscus-frame');
		iframe?.contentWindow?.postMessage(
			{ giscus: { setConfig: { theme: getTheme() } } },
			GISCUS_ORIGIN,
		);
	});
</script>
