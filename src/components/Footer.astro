---
const today = new Date();
---

<footer>
	<div class="inner">
		<span>&copy; {today.getFullYear()} mungonkim</span>
		<span class="links">
			<a href="https://github.com/mungonkim" target="_blank" rel="noopener">GitHub</a>
			<a href="/rss.xml">RSS</a>
		</span>
	</div>
</footer>

<style>
	footer {
		border-top: 1px solid var(--border);
		color: var(--muted);
		font-size: 0.9rem;
	}
	.inner {
		width: 960px;
		max-width: 100%;
		margin: 0 auto;
		padding: 2rem 1.25rem 3rem;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
	}
	.links {
		display: flex;
		gap: 1.25rem;
	}
	.links a {
		color: var(--muted);
		text-decoration: none;
	}
	.links a:hover {
		color: var(--accent);
	}
</style>
