---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import CategoryBadge from '../components/CategoryBadge.astro';
import Comments from '../components/Comments.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage, category } = Astro.props;

// 블로그 글에서만 댓글을 보여준다 (About 등 고정 페이지는 제외)
const showComments = Astro.url.pathname.startsWith('/blog/');
---

<html lang="ko">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			.post-header {
				margin-bottom: 2.5rem;
				padding-bottom: 2rem;
				border-bottom: 1px solid var(--border);
			}
			.category {
				margin-bottom: 0.8rem;
			}
			.date {
				margin: 0 0 0.8rem;
				color: var(--muted);
				font-size: 0.9rem;
				font-weight: 500;
			}
			.updated {
				margin-left: 0.5rem;
				color: var(--muted);
				font-weight: 400;
			}
			.post-header h1 {
				margin: 0 0 0.8rem;
				font-size: 2.1rem;
				background: var(--gradient);
				-webkit-background-clip: text;
				background-clip: text;
				-webkit-text-fill-color: transparent;
				color: transparent;
			}
			.post-header .lead {
				margin: 0;
				color: var(--muted);
			}
			.hero-image img {
				display: block;
				width: 100%;
				margin-bottom: 2.5rem;
				border-radius: var(--radius);
				box-shadow: var(--shadow);
			}
			.prose :global(h2) {
				margin-top: 2.5rem;
			}
			.prose :global(h3) {
				margin-top: 2rem;
			}
			.prose :global(ul),
			.prose :global(ol) {
				padding-left: 1.4rem;
				margin: 0 0 1.2em;
			}
			.prose :global(li) {
				margin-bottom: 0.4rem;
			}
			@media (max-width: 720px) {
				.post-header h1 {
					font-size: 1.7rem;
				}
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				<header class="post-header">
					{
						category && (
							<div class="category">
								<CategoryBadge name={category} link />
							</div>
						)
					}
					<p class="date">
						<FormattedDate date={pubDate} />
						{
							updatedDate && (
								<span class="updated">
									· 수정 <FormattedDate date={updatedDate} />
								</span>
							)
						}
					</p>
					<h1>{title}</h1>
					<p class="lead">{description}</p>
				</header>
				{
					heroImage && (
						<div class="hero-image">
							<Image width={1020} height={510} src={heroImage} alt="" />
						</div>
					)
				}
				<div class="prose">
					<slot />
				</div>
				{showComments && <Comments />}
			</article>
		</main>
		<Footer />
	</body>
</html>
