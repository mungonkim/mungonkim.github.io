---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

// 최신 글 5개만 노출
const recentPosts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 5);
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.hero {
				padding: 2rem 0 3.5rem;
			}
			.badge {
				display: inline-block;
				margin-bottom: 1.2rem;
				padding: 0.3rem 0.9rem;
				background: var(--accent-soft);
				color: var(--accent);
				border-radius: 999px;
				font-size: 0.85rem;
				font-weight: 600;
			}
			.hero h1 {
				margin-bottom: 1rem;
				font-size: 3rem;
				line-height: 1.2;
			}
			.gradient-text {
				background: var(--gradient);
				-webkit-background-clip: text;
				background-clip: text;
				-webkit-text-fill-color: transparent;
				color: transparent;
			}
			.hero p {
				max-width: 34rem;
				color: var(--muted);
				font-size: 1.1rem;
			}
			.actions {
				display: flex;
				gap: 0.75rem;
				margin-top: 1.8rem;
			}
			.btn {
				padding: 0.7rem 1.4rem;
				border-radius: 999px;
				font-weight: 600;
				text-decoration: none;
				transition:
					transform 0.15s ease,
					box-shadow 0.15s ease;
			}
			.btn:hover {
				transform: translateY(-2px);
			}
			.btn.primary {
				background: var(--gradient);
				color: #fff;
				box-shadow: 0 8px 24px rgba(99, 102, 241, 0.3);
			}
			.btn.primary:hover {
				color: #fff;
			}
			.btn.ghost {
				border: 1px solid var(--border);
				color: var(--text);
				background: var(--surface);
			}
			.btn.ghost:hover {
				color: var(--accent);
				border-color: var(--accent);
			}
			.section-head {
				display: flex;
				align-items: baseline;
				justify-content: space-between;
				margin-bottom: 1.2rem;
			}
			.section-head h2 {
				margin: 0;
			}
			.section-head a {
				font-size: 0.95rem;
				text-decoration: none;
			}
			.cards {
				list-style: none;
				margin: 0;
				padding: 0;
				display: grid;
				gap: 1.25rem;
			}
			.card {
				display: block;
				padding: 1.5rem 1.6rem;
				background: var(--surface);
				border: 1px solid var(--border);
				border-radius: var(--radius);
				box-shadow: var(--shadow);
				text-decoration: none;
				transition:
					transform 0.2s ease,
					box-shadow 0.2s ease,
					border-color 0.2s ease;
			}
			.card:hover {
				transform: translateY(-3px);
				box-shadow: var(--shadow-hover);
				border-color: var(--accent);
			}
			.card .date {
				margin: 0 0 0.4rem;
				color: var(--accent);
				font-size: 0.85rem;
				font-weight: 600;
			}
			.card .title {
				margin: 0 0 0.5rem;
				font-size: 1.25rem;
				color: var(--text);
			}
			.card .desc {
				margin: 0;
				color: var(--muted);
				font-size: 0.95rem;
			}
			@media (max-width: 720px) {
				.hero h1 {
					font-size: 2.2rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<span class="badge">매일 하나씩, 직접 써보며 배우는 중</span>
				<h1>
					<span class="gradient-text">AI랑 친해지기</span><br />프로젝트 기록
				</h1>
				<p>
					개발, 디자인, 마케팅, 데이터 분석, 콘텐츠 제작까지. 다양한 분야를 AI로 직접 경험하고, 그날
					배운 것과 막힌 점을 솔직하게 남기는 회고 · 기술 블로그입니다.
				</p>
				<div class="actions">
					<a class="btn primary" href="/blog/">글 읽어보기</a>
					<a class="btn ghost" href="/about/">소개</a>
				</div>
			</section>

			<div class="section-head">
				<h2>최근 글</h2>
				<a href="/blog/">전체 보기 →</a>
			</div>
			<ul class="cards">
				{
					recentPosts.map((post) => (
						<li>
							<a class="card" href={`/blog/${post.id}/`}>
								<p class="date">
									<FormattedDate date={post.data.pubDate} />
								</p>
								<h3 class="title">{post.data.title}</h3>
								<p class="desc">{post.data.description}</p>
							</a>
						</li>
					))
				}
			</ul>
		</main>
		<Footer />
	</body>
</html>
